# ── Telegram ────────────────────────────────────────────────────────────────
# Get these from @BotFather on Telegram.
# 1. Create a bot: /newbot in @BotFather → copy the token
# 2. Add the bot to your channel/group and send a message
# 3. Fetch your chat_id: https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Schedule ─────────────────────────────────────────────────────────────────
SCAN_HOUR=14
SCAN_MINUTE=0
SCAN_TIMEZONE=America/Denver    # MST/MDT

# ── Stage 1 filters ──────────────────────────────────────────────────────────
MIN_MARKET_CAP=5000000000       # $5B
MIN_AVG_DAILY_VOLUME=1000000    # $1M ADV30

# ── Stage 2 — 2YC 20/50/200 parameters, applied to 4H bars ──────────────────
MA_FAST_PERIOD=20
MA_FAST_TYPE=EMA
MA_SLOW_PERIOD=50
MA_SLOW_TYPE=EMA
MA_DIRECTION_PERIOD=200
MA_DIRECTION_TYPE=SMA
RSI_PERIOD=14
RSI_BUY_THRESHOLD=80.0
RSI_ENABLED=true
BUY_USE_OPEN_CROSS=true
BUY_USE_MA_CROSS=true

# ── D1 trend filter — yesterday's daily open must be above the daily SMA200 ─
DAILY_FILTER_ENABLED=true
DAILY_MA_PERIOD=200
DAILY_MA_TYPE=SMA

# ── Performance ───────────────────────────────────────────────────────────────
YFINANCE_RATE_LIMIT_DELAY=0.3   # seconds between yfinance calls per thread
MAX_WORKERS_PER_EXCHANGE=6      # parallel threads inside each exchange scan
